# SEC EDGAR API - Required (no account needed)
EDGAR_USER_AGENT="YourName your_email@domain.com"
EDGAR_BASE_URL="https://efts.sec.gov/LATEST"
EDGAR_ARCHIVE_URL="https://www.sec.gov/Archives/edgar/data"
DATA_DIR="./data/raw"
LOG_LEVEL="INFO"
EDGAR_MAX_RPS=10

# Google Gemini API
GOOGLE_API_KEY=""

# Langfuse Observability
LANGFUSE_PUBLIC_KEY="pk-lf-placeholder-public-key"
LANGFUSE_SECRET_KEY="sk-lf-placeholder-secret-key"
LANGFUSE_HOST="https://cloud.langfuse.com"

# FastAPI
FINRAG_API_KEY="placeholder-api-key"
FINRAG_INIT_PIPELINE="true"
FINRAG_MAX_SESSIONS=1000
FINRAG_PROMPT_VERSION="v1"
FINRAG_CORS_ORIGINS="*"

# Redis Caching
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://finrag_user:password@localhost:5432/finrag
POSTGRES_PASSWORD=password

# Rate Limiting & Logging
RATE_LIMIT_PER_MINUTE=10
LOG_FORMAT=console

# Google Analytics (GA4) - Replace with your own Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""


